<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>2.0.3</Version>
    <Copyright>(c) 2026 William Harvey</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NWaves" Version="0.9.6" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test bench is its own project -->
    <Compile Remove="Bench\**" />
    <EmbeddedResource Remove="Bench\**" />
    <None Remove="Bench\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- FFmpeg 9.0.2 (LGPL), the build sealed for the ABX apps, in an ffmpeg
         folder next to bpmGenie.exe (see AudioDecoder) -->
    <None Include="C:\tools\abx\ffmpeg\ffmpeg.exe" Link="ffmpeg\ffmpeg.exe" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>