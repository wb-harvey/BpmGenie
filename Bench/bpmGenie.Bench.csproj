<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>bpmGenie.Bench</RootNamespace>
    <Version>1.0.0</Version>
    <Copyright>(c) 2026 William Harvey</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NWaves" Version="0.9.6" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The app's decoder and V1 analyzer, compiled in unchanged; V2 is the BpmGenie.Core library -->
    <Compile Include="..\AudioDecoder.cs" Link="App\AudioDecoder.cs" />
    <Compile Include="..\BpmAnalyzerV1.cs" Link="App\BpmAnalyzerV1.cs" />
    <ProjectReference Include="..\BpmGenie.Core\BpmGenie.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same FFmpeg 9.0.2 build and layout as the app -->
    <None Include="C:\tools\abx\ffmpeg\ffmpeg.exe" Link="ffmpeg\ffmpeg.exe" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
